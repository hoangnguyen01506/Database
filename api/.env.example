# Cấu hình địa chỉ và cổng HTTP của API demo.
API_HOST=127.0.0.1
API_PORT=8000

# Cấu hình kết nối tới MySQL.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=food_delivery_db

# Tài khoản và mật khẩu riêng cho từng role; thay giá trị mẫu trước khi chạy.
MYSQL_CUSTOMER_USER=food_delivery_customer
MYSQL_CUSTOMER_PASSWORD=replace-with-customer-password
MYSQL_RESTAURANT_USER=food_delivery_restaurant
MYSQL_RESTAURANT_PASSWORD=replace-with-restaurant-password
MYSQL_DRIVER_USER=food_delivery_driver
MYSQL_DRIVER_PASSWORD=replace-with-driver-password
MYSQL_ADMIN_USER=food_delivery_admin
MYSQL_ADMIN_PASSWORD=replace-with-admin-password